# Required: PostgreSQL. DB_USER must remain "asm" for the checked-in v0.1 schema dump.
DB_HOST=db
DB_NAME=asm_db
DB_USER=asm
DB_PASSWORD=replace-with-a-long-random-password

# Optional: grounded AI Assistance. The backend remains usable if the endpoint is unavailable.
# host.docker.internal reaches an LLM running on the Docker host.
LLM_URL=http://host.docker.internal:11434/api/generate
LLM_MODEL=gemma3:4b

# Optional: CertSpotter enrichment. Empty disables the authenticated CertSpotter source.
CERTSPOTTER_API_KEY=

# Optional/reserved helper credentials. Current orchestration does not require them.
GITHUB_TOKEN=
CENSYS_API_ID=
CENSYS_API_SECRET=

# Optional: comma-separated direct scan operations. Empty or missing denies all.
# Supported: HTTP_TLS_OBSERVATION, TECHNOLOGY_HTTP, PORT_SCAN, ADHOC_CHECK
ASIP_DEFAULT_SCAN_OPERATIONS=

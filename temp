python3 - <<'PY'
from pathlib import Path

p = Path("/tmp/asip-machine2-deploy.sh")
s = p.read_text()

old = '''if ! git merge-base --is-ancestor HEAD "$TARGET"; then
  echo "STOP: Current checkout is not an ancestor."
  echo "No automatic merge or reset will be attempted."
  exit 1
fi'''

new = '''# A release may come from a separate Git branch.
# Verify the target exists and matches the fetched release.
git cat-file -e "$TARGET^{commit}"

# Preserve a reference to the current checkout.
CURRENT=$(git rev-parse HEAD)
echo "Previous checkout: $CURRENT"
echo "Verified target: $TARGET"

# Do not require the current branch to be an ancestor.
# The release switch below creates a new local branch.
'''

if old not in s:
    raise SystemExit("STOP: Expected ancestry guard not found")

p.write_text(s.replace(old, new, 1))
print("Release branch handling corrected.")
PY

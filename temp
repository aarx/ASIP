for n in 018 019 020; do
  file=$(find backend/migrations -maxdepth 1 \
    -name "${n}_*.sql" -print -quit)

  [ -n "$file" ] || { echo "Missing migration $n"; break; }

  echo "Applying $file"

  sudo docker compose -p asip exec -T db \
    psql -X -v ON_ERROR_STOP=1 -U asm -d asm_db \
    < "$file" || break
done






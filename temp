cd ~/Desktop/Projects/ASIP

echo "===== BACKEND IMAGE ====="
sudo docker inspect asm_backend \
  --format '{{.Config.Image}} | {{.State.Status}}'

echo "===== ALL SERVICES ====="
sudo docker compose \
  -f docker-compose.yml \
  -f /tmp/asip-pr4-override.yml ps

echo "===== BACKEND API ====="
curl -sS -o /dev/null -w 'OpenAPI: HTTP %{http_code}\n' \
  http://127.0.0.1:8555/openapi.json

echo "===== FRONTEND ====="
curl -sS -o /dev/null -w 'Frontend: HTTP %{http_code}\n' \
  http://127.0.0.1:3555/

echo "===== MCP ====="
curl -sS -o /dev/null -w 'MCP: HTTP %{http_code}\n' \
  http://127.0.0.1:8666/openapi.json

echo "===== DATABASE ====="
sudo docker inspect asm_db \
  --format '{{.State.Status}} | {{.State.Health.Status}}'

echo "===== RECENT SERVICE ERRORS ====="
for c in asm_backend asm_mcp asm_frontend; do
  echo "--- $c ---"
  sudo docker logs --since 5m "$c" 2>&1 |
    grep -Ei 'traceback|exception|critical|error' | tail -10 || true
done

cd ~/Desktop/Projects/ASIP || return 1

echo "========== 1. CONTAINER STATUS =========="
sudo docker ps -a --filter name=asm_backend \
  --format 'Name: {{.Names}} | Status: {{.Status}} | Image: {{.Image}}'

echo "========== 2. RUNNING IMAGE =========="
sudo docker inspect asm_backend \
  --format '{{.Config.Image}}' 2>&1

echo "========== 3. LOCAL UUID FIX =========="
grep -nE 'register_uuid|str\(operation_id\)|def _run_target' \
  backend/brand_redirect_worker.py

echo "========== 4. BACKUP EXISTS =========="
ls -l backend/brand_redirect_worker.py.pre_uuid_fix.bak 2>/dev/null \
  || echo "No backup created"

echo "========== 5. AVAILABLE BACKEND IMAGES =========="
sudo docker images --format '{{.Repository}}:{{.Tag}}' \
  | grep 'asip-backend' | head -15

echo "========== 6. COMPOSE BACKEND IMAGE =========="
sudo docker compose -p asip config --images 2>&1

echo "========== 7. SYNTAX CHECK =========="
python3 - <<'PY'

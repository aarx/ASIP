cd ~/Desktop/Projects/ASIP

cat > /tmp/asip-pr4-override.yml <<'EOF'
services:
  backend:
    image: asip-backend:pr4-ca1d5a4
EOF



sudo docker compose \
  -f docker-compose.yml \
  -f /tmp/asip-pr4-override.yml \
  config --quiet

sudo docker compose \
  -f docker-compose.yml \
  -f /tmp/asip-pr4-override.yml \
  config --format json | python3 -c '
import json, sys
service = json.load(sys.stdin)["services"]["backend"]
print("Backend image:", service["image"])
print("Volume mounts:", len(service.get("volumes", [])))
'


sudo docker compose \
  -f docker-compose.yml \
  -f /tmp/asip-pr4-override.yml \
  up -d --no-deps --no-build backend


echo "========== BACKEND IMAGE =========="
sudo docker inspect asm_backend \
  --format '{{.Config.Image}} | {{.Image}}'

echo "========== CONTAINER STATUS =========="
sudo docker compose \
  -f docker-compose.yml \
  -f /tmp/asip-pr4-override.yml \
  ps

echo "========== BACKEND LOGS =========="
sudo docker logs --tail 60 asm_backend


sed -i \
  's|asip-backend:pr4-ca1d5a4|asip-backend:machine2-pre-pr4-rollback|' \
  /tmp/asip-pr4-override.yml

sudo docker compose \
  -f docker-compose.yml \
  -f /tmp/asip-pr4-override.yml \
  up -d --no-deps --no-build backend

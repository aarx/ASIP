cat > /tmp/asip-report-deploy-fixed.sh <<'BASH'
#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="/home/kali/Desktop/Projects/ASIP"
SHA="fdd3c54266a20e46401713af41ebcc5854deb6e4"
STAMP="$(date +%Y%m%d-%H%M%S)"

BACKUP="/home/kali/asip-report-backup-fixed-$STAMP"
BUILDROOT="/home/kali/asip-report-build-$STAMP"
BUILD_OVERRIDE="$BACKUP/frontend-build.json"
DEPLOY_OVERRIDE="$BACKUP/deploy.json"
ROLLBACK_OVERRIDE="$BACKUP/rollback.json"

BACKEND_TAG="asip-backend:report-${SHA:0:12}"
FRONTEND_TAG="asip-frontend:report-${SHA:0:12}"

mkdir -p "$BACKUP" "$BUILDROOT"
chmod 700 "$BACKUP"

exec > >(tee "$BACKUP/deployment.log") 2>&1

cd "$ROOT"
sudo -v

echo "===== 1. LOCATE VERIFIED RELEASE ====="

SOURCE=""

for DIR in /home/kali/asip-report-source-*; do
    [ -d "$DIR" ] || continue

    FOUND="$(git -C "$DIR" rev-parse HEAD 2>/dev/null || true)"

    if [ "$FOUND" = "$SHA" ]; then
        SOURCE="$DIR"
        break
    fi
done

if [ -z "$SOURCE" ]; then
    echo "STOP: Verified release checkout not found"
    exit 1
fi

echo "Release: $SHA"
echo "Source: $SOURCE"

echo "===== 2. VERIFY RUNNING CONTAINERS ====="

BID="$(sudo docker compose ps -q backend)"
FID="$(sudo docker compose ps -q frontend)"

[ -n "$BID" ] && [ -n "$FID" ] || {
    echo "STOP: Application containers not found"
    exit 1
}

for ID in "$BID" "$FID"; do
    STATUS="$(sudo docker inspect "$ID" --format '{{.State.Status}}')"
    [ "$STATUS" = "running" ] || {
        echo "STOP: Existing application is not running"
        exit 1
    }
done

PROJECT="$(sudo docker inspect "$BID" \
  --format '{{index .Config.Labels "com.docker.compose.project"}}')"

FPROJECT="$(sudo docker inspect "$FID" \
  --format '{{index .Config.Labels "com.docker.compose.project"}}')"

[ -n "$PROJECT" ] && [ "$PROJECT" = "$FPROJECT" ] || {
    echo "STOP: Compose project mismatch"
    exit 1
}

export COMPOSE_PROJECT_NAME="$PROJECT"
export COMPOSE_PARALLEL_LIMIT=1

echo "===== 3. PRESERVE ROLLBACK IMAGES ====="

OLD_BACKEND="$(sudo docker inspect "$BID" --format '{{.Image}}')"
OLD_FRONTEND="$(sudo docker inspect "$FID" --format '{{.Image}}')"

sudo docker image tag "$OLD_BACKEND" \
  "asip-rollback-backend:$STAMP"

sudo docker image tag "$OLD_FRONTEND" \
  "asip-rollback-frontend:$STAMP"

echo "Rollback images preserved"

echo "===== 4. PREPARE SAFE BUILD CONTEXTS ====="

mkdir -p "$BUILDROOT/backend" "$BUILDROOT/frontend"

# Copy release code while excluding protected data,
# local environments and generated dependencies.

tar -C "$SOURCE/backend" \
  --exclude='./data' \
  --exclude='./.git' \
  --exclude='./.env' \
  --exclude='./__pycache__' \
  -cf - . | tar -C "$BUILDROOT/backend" -xf -

tar -C "$SOURCE/frontend" \
  --exclude='./node_modules' \
  --exclude='./build' \
  --exclude='./.git' \
  --exclude='./.env' \
  -cf - . | tar -C "$BUILDROOT/frontend" -xf -

[ -f "$BUILDROOT/backend/Dockerfile" ] || {
    echo "STOP: Backend Dockerfile missing"
    exit 1
}

[ -f "$BUILDROOT/frontend/Dockerfile" ] || {
    echo "STOP: Frontend Dockerfile missing"
    exit 1
}

echo "===== 5. VERIFY COMPOSE AND BUILD SETTINGS ====="

python3 - "$ROOT" "$BUILDROOT" \
  "$BUILD_OVERRIDE" "$DEPLOY_OVERRIDE" \
  "$ROLLBACK_OVERRIDE" "$BACKEND_TAG" "$FRONTEND_TAG" \
  "$STAMP" <<'PY'
import json
import os
import subprocess
import sys

(root, buildroot, buildfile, deployfile,
 rollbackfile, backend_tag, frontend_tag,
 stamp) = sys.argv[1:]

raw = subprocess.check_output(
    ["sudo", "docker", "compose", "config", "--format", "json"],
    cwd=root,
    text=True
)

config = json.loads(raw)
services = config.get("services", {})

for name in ("backend", "frontend"):
    if name not in services:
        raise SystemExit(f"STOP: Missing service {name}")

frontend_build = services["frontend"].get("build")

if not isinstance(frontend_build, dict):
    raise SystemExit("STOP: Frontend build config unavailable")

if frontend_build.get("additional_contexts"):
    raise SystemExit("STOP: Additional build contexts need review")

dockerfile = frontend_build.get("dockerfile", "Dockerfile")
if os.path.isabs(dockerfile) or ".." in dockerfile.split(os.sep):
    raise SystemExit("STOP: Unexpected frontend Dockerfile path")

# Keep all existing frontend build args and settings.
# Only redirect its build context to the release code.
frontend_build = dict(frontend_build)
frontend_build["context"] = os.path.join(buildroot, "frontend")

for name in ("backend", "frontend"):
    for volume in services[name].get("volumes", []):
        if not isinstance(volume, dict):
            continue
        if volume.get("type") != "bind":
            continue

        source = os.path.realpath(volume.get("source", ""))
        target = str(volume.get("target", ""))

        # Existing data/config mounts are preserved.
        # Reject mounts that mask the application code.
        if name == "backend" and target in (
            "/app", "/app/main.py", "/app/scan_report.py"
        ):
            raise SystemExit("STOP: Backend code bind mount")

        if name == "frontend" and target in (
            "/app", "/usr/share/nginx/html"
        ):
            raise SystemExit("STOP: Frontend code bind mount")

build = {
    "services": {
        "frontend": {
            "image": frontend_tag,
            "build": frontend_build
        }
    }
}

deploy = {
    "services": {
        "backend": {"image": backend_tag},
        "frontend": {"image": frontend_tag}
    }
}

rollback = {
    "services": {
        "backend": {
            "image": f"asip-rollback-backend:{stamp}"
        },
        "frontend": {
            "image": f"asip-rollback-frontend:{stamp}"
        }
    }
}

for path, obj in (
    (buildfile, build),
    (deployfile, deploy),
    (rollbackfile, rollback)
):
    with open(path, "w") as f:
        json.dump(obj, f, indent=2)

print("Compose configuration: PASS")
PY

echo "===== 6. BUILD BACKEND IMAGE ====="

sudo docker build \
  --pull=false \
  -t "$BACKEND_TAG" \
  -f "$BUILDROOT/backend/Dockerfile" \
  "$BUILDROOT/backend"

echo "===== 7. BUILD FRONTEND IMAGE ====="

sudo docker compose \
  --project-directory "$ROOT" \
  -f "$ROOT/docker-compose.yml" \
  -f "$BUILD_OVERRIDE" \
  build frontend

echo "===== 8. VERIFY BOTH IMAGES ====="

sudo docker image inspect "$BACKEND_TAG" \
  --format 'Backend image: {{.Id}}'

sudo docker image inspect "$FRONTEND_TAG" \
  --format 'Frontend image: {{.Id}}'

echo "===== 9. DEPLOY BACKEND AND FRONTEND ONLY ====="

sudo docker compose \
  --project-directory "$ROOT" \
  -f "$ROOT/docker-compose.yml" \
  -f "$DEPLOY_OVERRIDE" \
  up -d --no-deps --no-build \
  --force-recreate backend frontend

echo "===== 10. VERIFY RUNNING RELEASE ====="

sudo docker compose \
  --project-directory "$ROOT" \
  -f "$ROOT/docker-compose.yml" \
  -f "$DEPLOY_OVERRIDE" \
  ps backend frontend

echo "===== 11. FRONTEND HEALTH ====="

if curl -fsS --max-time 10 \
  -o /dev/null http://127.0.0.1:3555/; then
    echo "FRONTEND HTTP: PASS"
else
    echo "FRONTEND HTTP: CHECK REQUIRED"
fi

echo
echo "======================================"
echo "REPORTING DEPLOYMENT COMMANDS COMPLETE"
echo "======================================"
echo "Release: $SHA"
echo "Backup: $BACKUP"
echo "Rollback override: $ROLLBACK_OVERRIDE"
echo
echo "Database/MCP not redeployed."
echo "No scan initiated."
echo "Verify reporting in the dashboard."
BASH

chmod +x /tmp/asip-report-deploy-fixed.sh
bash /tmp/asip-report-deploy-fixed.sh

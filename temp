sudo docker exec asm_db psql -U asm -d asm_db -c "
SELECT
    a->>'stage' AS stage,
    a->>'status' AS status,
    a->>'started_at' AS started_at,
    a->'worker_summary' AS worker_summary,
    a->>'error_category' AS error
FROM scans s
CROSS JOIN LATERAL jsonb_array_elements(
    COALESCE(s.stage_diagnostics->'attempts', '[]'::jsonb)
) AS a
WHERE s.id = 9
  AND a->>'stage' ILIKE '%Brand Redirect%';
"

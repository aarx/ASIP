DOMAIN="portal.example.com"

echo "=== CNAME CHAIN ==="
dig +noall +answer "$DOMAIN" CNAME

echo "=== ADDRESS RESOLUTION ==="
dig +noall +answer "$DOMAIN" A
dig +noall +answer "$DOMAIN" AAAA

echo "=== DNS STATUS ==="
dig +noall +comments "$DOMAIN" A | grep status

echo "=== HTTP RESPONSE ==="
curl -sS -I --max-time 8 "https://$DOMAIN"

echo "=== TLS CERTIFICATE ==="
timeout 10 openssl s_client \
  -connect "$DOMAIN:443" \
  -servername "$DOMAIN" \
  </dev/null 2>/dev/null |
  openssl x509 -noout -subject -issuer -dates



TARGET="app123.azurewebsites.net"

dig +noall +answer "$TARGET" A
dig +noall +answer "$TARGET" AAAA
dig +noall +comments "$TARGET" A | grep status

cd ~/Desktop/Projects/ASIP

echo "========== DEPLOYED BACKEND =========="
sudo docker inspect asm_backend \
  --format 'Image: {{.Config.Image}} | Status: {{.State.Status}} | Health: {{if .State.Health}}{{.State.Health.Status}}{{else}}not configured{{end}}'

echo "========== HEALTH ENDPOINT =========="
curl -sS -o /dev/null -w 'HTTP %{http_code}\n' \
  http://localhost:8555/health

echo "========== RECENT BACKEND ERRORS =========="
sudo docker logs --since 10m asm_backend 2>&1 | \
  grep -Ei 'traceback|error|exception|failed' | tail -30 || true

echo "========== MCP STATUS =========="
sudo docker inspect asm_mcp \
  --format 'Image: {{.Config.Image}} | Status: {{.State.Status}}'

echo "========== DATABASE STATUS =========="
sudo docker inspect asm_db \
  --format 'Status: {{.State.Status}} | Health: {{.State.Health.Status}}'

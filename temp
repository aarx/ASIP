cd ~/Desktop/Projects/ASIP

bash <<'FIX_UUID'
set -e

echo "===== 1. CHECK SCAN STATUS ====="
RUNNING=$(sudo docker exec asm_db psql -U asm -d asm_db -Atc \
  "SELECT COUNT(*) FROM scans WHERE status='RUNNING';")

if [ "$RUNNING" != "0" ]; then
    echo "STOP: A scan is running."
    exit 1
fi

echo "===== 2. PATCH UUID ADAPTER ====="
python3 - <<'PY'
from pathlib import Path

p = Path("backend/brand_redirect_worker.py")
s = p.read_text()

old = "def _run_target(row, scan_id, operation_id, request_budget):"

if s.count(old) != 1:
    raise SystemExit("Unexpected worker source. No changes applied.")

if "from psycopg2.extras import register_uuid" not in s:
    lines = s.splitlines(keepends=True)
    insert_at = next(
        (i for i, line in enumerate(lines)
         if line.startswith("from db import ") or
            line.startswith("import db")),
        None
    )
    if insert_at is None:
        raise SystemExit("DB import not found. No changes applied.")
    lines.insert(insert_at, "from psycopg2.extras import register_uuid\n")
    s = "".join(lines)

if "    register_uuid()" not in s:
    s = s.replace(
        old,
        old + "\n    register_uuid()",
        1
    )

p.write_text(s)
print("UUID adapter fix applied.")
PY

echo "===== 3. CHECK PYTHON SYNTAX ====="
python3 -m py_compile backend/brand_redirect_worker.py

echo "===== 4. BUILD NEW BACKEND IMAGE ====="
sudo docker build \
  -f backend/Dockerfile \
  -t asip-backend:brand-redirect-uuid-v2 \
  backend/

echo "===== 5. TEST UUID ADAPTATION ====="
sudo docker run --rm \
  --entrypoint python \
  asip-backend:brand-redirect-uuid-v2 \
  -c 'import uuid; from psycopg2.extensions import adapt; from psycopg2.extras import register_uuid; register_uuid(); print("UUID adaptation PASS:", adapt(uuid.uuid4()).getquoted())'

echo "===== 6. UPDATE COMPOSE IMAGE ====="
python3 - <<'PY'
from pathlib import Path

p = Path("docker-compose.yml")
s = p.read_text()

old = "asip-backend:brand-redirect-fixed"
new = "asip-backend:brand-redirect-uuid-v2"

if s.count(old) != 1:
    raise SystemExit("Expected backend image reference not found.")

p.write_text(s.replace(old, new, 1))
print("Compose image updated.")
PY

echo "===== 7. VALIDATE COMPOSE ====="
sudo docker compose -p asip config --quiet

echo "===== 8. DEPLOY BACKEND ONLY ====="
sudo docker compose -p asip up -d \
  --no-deps --no-build --force-recreate backend

echo "===== 9. VERIFY DEPLOYMENT ====="
sudo docker inspect asm_backend \
  --format 'Running image: {{.Config.Image}}'

sudo docker exec asm_backend python -c '
import inspect
import brand_redirect_worker

s = inspect.getsource(brand_redirect_worker)

print("Candidate-selection fix:", "reporting_asset_class_sql" in s)
print("UUID adapter fix:", "register_uuid()" in s)
'

echo "===== FIX COMPLETE ====="
FIX_UUID
